# Base URL of the Raphael FastAPI server (see ../README.md for how to run it).
# Defaults to http://localhost:8000 if unset.
VITE_API_BASE_URL=http://localhost:8000

# Firebase web app config, used for Google sign-in. These are public client
# identifiers rather than secrets -- they ship in the built bundle, and access
# is controlled by the Firebase console's authorized domains, not by hiding
# them. Re-fetch with:
#   firebase apps:sdkconfig WEB 1:621394626388:web:d575a159f38f991a446ac1
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_firebase_auth_domain"
VITE_FIREBASE_PROJECT_ID="your_firebase_project_id"
VITE_FIREBASE_APP_ID="your_firebase_app_id"
